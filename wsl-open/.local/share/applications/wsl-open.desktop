[Desktop Entry]
Type=Application
Name=Windows default app (WSL)
Comment=Open files and URLs with the Windows host (Firefox for http/https)
Exec=/home/vanzen/.local/bin/wsl-open %u
Terminal=false
NoDisplay=true
